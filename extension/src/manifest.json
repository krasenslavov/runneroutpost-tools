{
  "manifest_version": 3,
  "name": "RunnerOutpost - Group Run Tools",
  "version": "1.0.0",
  "description": "Weekly schedule to calendar file, GPX route start and end trimmer, and a run time in every time zone. Free, private, offline.",
  "action": {
    "default_title": "RunnerOutpost - Group Run Tools",
    "default_popup": "popup.html",
